{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geography publication payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["data/geography/manifest.json", "data/geography/barangays.json", "data/geography/municipalities.geojson"],
  "properties": {
    "data/geography/manifest.json": {
      "type": "object",
      "required": ["version", "municipality_count", "expected_municipality_count", "geometry_status", "barangay_status", "barangay_count", "barangay_source", "sources", "attribution", "license_url", "province_boundary_metadata", "matching"],
      "properties": {
        "version": {"const": 1},
        "municipality_count": {"type": "integer", "minimum": 0, "maximum": 48},
        "expected_municipality_count": {"const": 48},
        "geometry_status": {"enum": ["complete", "partial", "unavailable"]},
        "barangay_status": {"enum": ["complete", "partial", "unavailable"]},
        "barangay_count": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {"type": "object", "required": ["url", "retrieved_at", "sha256"], "properties": {"url": {"type": "string", "format": "uri"}, "retrieved_at": {"type": "string", "format": "date-time"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }
    },
    "data/geography/barangays.json": {"type": "array", "items": {"type": "object", "required": ["psgc", "raw_code", "parent_psgc", "parent_id", "parent_mapping", "name", "publisher", "source_url", "license", "license_url", "release", "source_sha256"], "properties": {"psgc": {"type": "string", "pattern": "^[0-9]{10}$"}, "raw_code": {"type": "string", "pattern": "^[0-9]{10}$"}, "parent_id": {"type": "string", "pattern": "^lgu-[0-9]{10}$"}, "parent_psgc": {"type": "string", "pattern": "^[0-9]{10}$"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "data/geography/municipalities.geojson": {"type": "object", "required": ["type", "features"], "properties": {"type": {"const": "FeatureCollection"}, "features": {"type": "array", "items": {"type": "object", "required": ["type", "properties", "geometry"], "properties": {"type": {"const": "Feature"}, "properties": {"type": "object", "required": ["id", "psgc", "name", "classification", "population_2024", "barangay_count", "source_url", "source_sha256", "license", "release"], "properties": {"psgc": {"type": "string", "pattern": "^[0-9]{10}$"}, "id": {"type": "string", "pattern": "^lgu-[0-9]{10}$"}, "barangay_count": {"type": ["integer", "null"], "minimum": 0}}}, "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"enum": ["Polygon", "MultiPolygon"]}, "coordinates": {"type": "array", "minItems": 1}}}}}}}}
  }
}
