{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "is_mock", "publication_status", "verification_status", "availability"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "is_mock": {"type": "boolean"},
    "publication_status": {"enum": ["approved", "draft", "test_only"]},
    "verification_status": {"enum": ["unreviewed", "reviewed", "verified"]},
    "availability": {"enum": ["available", "not_yet_collected", "not_located_in_reviewed_sources", "not_yet_due", "under_review", "source_inaccessible", "not_applicable"]},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "entity_id": {"type": ["string", "null"]},
    "lgu_id": {"type": ["string", "null"]},
    "project_id": {"type": ["string", "null"]},
    "procurement_id": {"type": ["string", "null"]},
    "contract_id": {"type": ["string", "null"]},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "published_date": {"type": ["string", "null"], "format": "date"},
    "accessed_date": {"type": "string", "format": "date"},
    "reporting_period": {"type": "string", "pattern": "^[0-9]{4}$"},
    "psgc": {"type": ["string", "null"], "pattern": "^[0-9]{10}$"},
    "classification": {"enum": ["city", "municipality", null]},
    "amount": {"type": ["number", "null"], "minimum": 0},
    "amount_type": {"enum": ["appropriation", "actual_expenditure", "approved_budget", "contract_value"]},
    "category": {"enum": ["general_public_services", "education", "health", "economic_services", "social_services", "other"]},
    "unit": {"enum": ["PHP", "persons", "percent", "count"]},
    "geometry": {"type": ["object", "null"]},
    "license": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "supplier": {"type": ["string", "null"]},
    "methodology": {"type": ["string", "null"]},
    "status": {"enum": ["planned", "under_procurement", "awarded", "ongoing", "completed", "suspended", "cancelled", "unknown"]},
    "requirements": {"type": ["array", "null"], "items": {"type": "string"}},
    "processing_time": {"type": ["string", "null"]},
    "fees": {"type": ["string", "null"]},
    "publisher": {"type": ["string", "null"]},
    "source_type": {"type": ["string", "null"]},
    "redistribution_notes": {"type": ["string", "null"]},
    "definition": {"type": ["string", "null"]},
    "reference_period": {"type": ["string", "null"]},
    "reference_metadata": {"type": ["object", "null"], "properties": {"notes": {"type":"string"}, "url": {"type":"string", "format":"uri", "pattern":"^https://"}}, "additionalProperties": false}
  }
}
