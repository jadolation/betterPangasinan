{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "sources", "attractions", "foods"],
  "$defs": {
    "status": {
      "type": "object",
      "required": ["is_mock", "publication_status", "verification_status", "source_ids"],
      "properties": {
        "is_mock": {"type": "boolean"},
        "publication_status": {"enum": ["approved", "draft", "withdrawn"]},
        "verification_status": {"enum": ["reviewed", "verified", "unreviewed"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt", "author", "license", "license_url", "source_url"],
      "properties": {
        "file": {"type": "string", "pattern": "^assets/tourism/[a-z0-9-]+\\.(webp|jpg|svg)$"},
        "file_small": {"type": "string", "pattern": "^assets/tourism/[a-z0-9-]+\\.(webp|jpg)$"},
        "alt": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "license": {"type": "string"},
        "license_url": {"type": "string", "pattern": "^https://"},
        "source_url": {"type": "string", "pattern": "^https://"}
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "from", "to"],
      "properties": {
        "mode": {"enum": ["bus", "jeepney", "van", "tricycle", "boat", "walk"]},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "operator": {"type": "string"},
        "duration_text": {"type": "string"},
        "fare_text": {"type": "string"},
        "fare_as_of": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    },
    "id": {"type": "string", "pattern": "^(mock-)?[a-z0-9]+(-[a-z0-9]+)*$"},
    "lgu_id": {"type": "string", "pattern": "^lgu-[0-9]{10}$"}
  },
  "properties": {
    "schema_version": {"const": 1},
    "metadata": {
      "type": "object",
      "required": ["collected_at"],
      "properties": {"collected_at": {"type": "string", "format": "date-time"}, "note": {"type": "string"}}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "publisher", "retrieved_at"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "publisher": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "attractions": {
      "type": "array",
      "items": {
        "allOf": [{"$ref": "#/$defs/status"}],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "name", "lgu_id", "categories", "is_hidden_spot", "summary", "coordinates", "tips", "nearby_ids", "food_ids", "photo", "routes", "checked_on"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "lgu_id": {"$ref": "#/$defs/lgu_id"},
          "barangay": {"type": "string"},
          "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["beach", "island", "falls", "cave", "heritage", "pilgrimage", "nature", "festival"]}},
          "is_hidden_spot": {"type": "boolean"},
          "summary": {"type": "string", "minLength": 1},
          "coordinates": {
            "type": "object", "additionalProperties": false, "required": ["lat", "lon"],
            "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}
          },
          "coordinate_source_id": {"type": "string"},
          "best_time": {"type": "string"},
          "entrance_fee_text": {"type": "string"},
          "fee_as_of": {"type": "string", "format": "date"},
          "tips": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "responsible_visit": {"type": "string"},
          "nearby_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "food_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "photo": {"$ref": "#/$defs/photo"},
          "routes": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["origin", "legs", "source_ids"],
              "properties": {
                "origin": {"type": "string", "minLength": 1},
                "legs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leg"}},
                "gap_note": {"type": "string", "minLength": 1},
                "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "private_vehicle_note": {"type": "string"},
          "checked_on": {"type": "string", "format": "date"},
          "is_mock": true, "publication_status": true, "verification_status": true, "source_ids": true
        }
      }
    },
    "foods": {
      "type": "array",
      "items": {
        "allOf": [{"$ref": "#/$defs/status"}],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "name", "description", "lgu_id", "attraction_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "lgu_id": {"$ref": "#/$defs/lgu_id"},
          "where_to_try": {"type": "string"},
          "attraction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "photo": {"$ref": "#/$defs/photo"},
          "is_mock": true, "publication_status": true, "verification_status": true, "source_ids": true
        }
      }
    }
  }
}
