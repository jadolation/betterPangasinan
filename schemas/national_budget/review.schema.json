{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["snapshot_id", "candidate_sha256", "reviewer", "reviewed_at", "allow_incomplete_coverage", "projects", "offices", "lgu_registry"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["kind", "scope", "statement", "authorized_at", "recorded_by", "original_candidate_sha256", "source_values_sha256"], "properties": {
      "kind": {"const": "explicit_user_publication"}, "scope": {"const": "publication_only"},
      "statement": {"type": "string", "minLength": 1}, "authorized_at": {"type": "string", "format": "date-time"},
      "recorded_by": {"type": "string", "minLength": 1}, "original_candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "source_values_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }},
    "allow_incomplete_coverage": {"type": "boolean"},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "lgu_registry": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["psgc", "name", "source_url", "reviewer", "reviewed_at", "release"], "properties": {
      "psgc": {"type": "string", "pattern": "^01055[0-9]{2}000$"}, "name": {"type": "string", "minLength": 1},
      "source_url": {"type": "string", "format": "uri"}, "release": {"type": "string", "minLength": 1},
      "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}
    }}},
    "offices": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "sha256", "reviewer", "reviewed_at"], "properties": {
      "id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}
    }}}
  },
  "$defs": {
    "association": {"type": "object", "additionalProperties": false, "required": ["psgc", "name", "evidence_source_ids", "review_status", "reviewer", "reviewed_at"], "properties": {
      "psgc": {"type": "string", "pattern": "^01055[0-9]{2}000$"}, "name": {"type": "string", "minLength": 1},
      "evidence_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "review_status": {"const": "reviewed"}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}
    }},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "record_sha256", "decision", "reviewer", "reviewed_at"], "properties": {
      "id": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision": {"enum": ["approve", "exclude"]},
      "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}, "exclusion_reason": {"type": "string"},
      "scope": {"enum": ["geographic", "office", "shared", "uncertain"]}, "geographic_review_status": {"enum": ["pending", "reviewed"]},
      "source_review_status": {"enum": ["reviewed", "reviewed_with_warnings"]}, "evidence_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "lgu_associations": {"type": "array", "items": {"$ref": "#/$defs/association"}}
    }, "allOf": [{"if": {"properties": {"decision": {"const": "approve"}}}, "then": {"required": ["scope", "geographic_review_status", "source_review_status", "evidence_source_ids", "lgu_associations"]}, "else": {"required": ["exclusion_reason"]}}]}
  }
}
