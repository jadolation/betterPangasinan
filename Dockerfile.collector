FROM python:3.12-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-collector.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-collector.lock \
    && useradd --uid 10001 --create-home collector
COPY collector ./collector
COPY config/sources ./config/sources
COPY pangasinan_lgu_registry_staging.json ./pangasinan_lgu_registry_staging.json
COPY tests/integration ./tests/integration
COPY scripts ./scripts
COPY data/national_budget/config.json ./data/national_budget/config.json
COPY migrations ./migrations
USER 10001
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-m", "collector.cli"]
CMD ["--help"]
