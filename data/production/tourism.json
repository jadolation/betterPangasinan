  "attractions": [
    {
      "id": "hundred-islands-national-park",
      "name": "Hundred Islands National Park",
      "lgu_id": "lgu-0105503000",
      "barangay": "Lucap (jump-off point)",
      "categories": [
        "island",
        "nature",
        "beach"
      ],
      "is_hidden_spot": false,
      "summary": "A spectacle of 123 islands, plus one more at low tide, and the first national park of the Philippines, declared on January 14, 1940. Governor's Island has a view deck and a zip line to Virgin Island.",
      "coordinates": {
        "lat": 16.2,
        "lon": 120.03333
      },
      "coordinate_source_id": "wd-hundred-islands",
      "tips": [
        "Boat tours are arranged at the City Tourism Office – Welcome Center at Lucap Wharf.",
        "Governor's Island and Virgin Island are linked by a zip line and a 120-metre pontoon bridge.",
        "Restaurants and places to stay line the streets around Lucap Wharf."
      ],
      "responsible_visit": "Take your trash home, follow posted rules and ask the municipal tourism office before visiting restricted areas.",
      "nearby_ids": [
        "umbrella-rocks",
        "patar-beach"
      ],
      "food_ids": [
        "alaminos-longganisa",
        "sual-dried-fish"
      ],
